<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.precheck</groupId>
	<artifactId>expense-precheck</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>expense-precheck</name>
	<description>审批材料预检助手：提交前检查材料完整性、金额一致性、政策冲突</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>
		<!-- Web 层。注意 Boot 4.x 已经把 starter-web 拆成 starter-webmvc，名字变了 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- PDF 文本抽取。
		     ⚠️ 这个依赖不在 Spring Boot 的托管名单里，<version> 必须自己写。
		     我们只用它读电子发票的"文本层"，不做 OCR（图片扫描件不支持）。 -->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.5</version>
		</dependency>

		<!-- 测试：Boot 4.x 同样把 web 测试包拆出来了 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
